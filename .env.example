# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Zenon Node
ZNN_NODE_URL=wss://node.zenonhub.io:35998

# Wallet
KEYFILE_PATH=/etc/plasma-bot/wallet.json
# KEYFILE_PASSWORD — in dev: set here; in production: /etc/plasma-bot/secrets.env
KEYFILE_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/plasma-bot

# Admin (required — admin endpoints are disabled without this)
# ADMIN_API_KEY — in dev: set here; in production: /etc/plasma-bot/secrets.env
ADMIN_API_KEY=

# Rate limiting
RATE_LIMIT_PER_IP_MAX=4
# Per-IP daily cap for the public /api/agent/fuse endpoint
AGENT_RATE_LIMIT_PER_IP_MAX=10
# Global daily cap for /api/agent/fuse across ALL callers. This is the wallet's
# backstop against a drain via unlimited addresses/IPs (both are free to an
# attacker), so per-IP limits alone cannot bound total dispensation. Tune to
# expected legitimate agent volume.
AGENT_GLOBAL_DAILY_MAX=100
# Global daily caps for the other entry points. Telegram accounts and client
# IPs are also cheap to an attacker, so per-user/per-IP limits alone don't
# bound total dispensation for these sources either.
TELEGRAM_GLOBAL_DAILY_MAX=100
WEB_GLOBAL_DAILY_MAX=200

# How long (ms) to hold an in-memory QSR reservation after a fuse is sent, to
# cover the gap before the on-chain balance reflects the spend. Prevents
# concurrent requests from over-spending against a stale balance read.
RESERVATION_HOLD_MS=30000

# Thresholds
BALANCE_THRESHOLD_QSR=500

# Telegram Bot (optional — disabled without TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_RATE_LIMIT_PER_USER_MAX=4
