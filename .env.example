# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Zenon Node
ZNN_NODE_URL=wss://node.zenonhub.io:35998

# Wallet (NEVER commit real values)
KEYFILE_PATH=/etc/plasma-bot/wallet.json
KEYFILE_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/plasma-bot

# Admin (required — admin endpoints are disabled without this)
ADMIN_API_KEY=

# Rate limiting
RATE_LIMIT_PER_IP_MAX=4

# Thresholds
BALANCE_THRESHOLD_QSR=500
MIN_FUSE_DURATION_HOURS=12
