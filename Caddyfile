plazma.bot {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	# API reverse proxy
	handle /api/* {
		reverse_proxy backend:3001 {
			header_up X-Real-IP {header.CF-Connecting-IP}
			header_up X-Forwarded-For {header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Frontend static files (SPA)
	handle {
		root * /srv/frontend

		# Hashed Vite assets: cache forever (immutable filenames)
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# HTML: always revalidate to pick up new deploys
		@html path /
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		encode zstd gzip
		file_server
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Request size limit (matches Express 1kb limit)
	request_body {
		max_size 1KB
	}
}
